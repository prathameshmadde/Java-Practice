import java.util.Scanner;

class  Pattern11 {
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no of Rows : ");
		int n = sc.nextInt();
		int b = n*n -1;
		int c =1;
		
		
		for (int i=1 ; i<=n ; i++ )
		{	int a =i;
			
			for (int j=1 ; j<=n ; j++)
				
			{
				System.out.print(a +" ");
				
				a=(j%2!=0)?a=a+b:a=a+c;
				
			}
			b-=2;
			c+=2;
			
			
			System.out.println();
		}
	}
}

