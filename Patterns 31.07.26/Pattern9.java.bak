import java.util.Scanner;

class  Pattern9{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no of rows : ");
		int n = sc.nextInt();
		char a ='a';
		int num=1;
		
		
		for (int i=1 ; i<=n ; i++ )
		{
			for (int j=1 ; j<=n ; j++)
				
			{
				if(i%2!=0)
					{System.out.print(num++ + " ");
					
					if(num<=10)System.out.print(" ");
					}
				
				else{System.out.print(a++ + "  ");}
				
				
			}
			System.out.println();
		}
	}
}