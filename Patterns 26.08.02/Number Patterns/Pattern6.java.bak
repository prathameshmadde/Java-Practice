import java.util.Scanner;

class Pattern6
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of Rows : ");
        int n = sc.nextInt();
		int num = n;
        for (int i=1;i<=n ;i++ )
        {
			for (int j=1;j<=n ;j++ )
			{
				if (i%2!=0)
				{
					System.out.print(num-- + " ");
					if(num<10) System.out.print(" ");
				}
				else
				{
					System.out.print(num++ + " ");
					if(num<=10) System.out.print(" ");
				}
				
			}
			if(i%2!=0){ num+=n+1; }
			else { num+=n-1; }
			System.out.println();
        }
    }
}