import java.util.Scanner;

class Pattern20 
{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("ENter no of Rows : ");
		int n = sc.nextInt();
		int num = 1;
		char ch = (char)('a'+n*n/2-1);
		
		for (int i=1; i<=n ; i++ )
		{
			for (int j=1;j<=n ;j++ )
			{
				if(j%2!=0){
					System.out.print(num+ " ");
					num=num+4;
				}
				else{
					System.out.print(ch+ " ");
					ch-=4;
				}
			}
			num-=7;
			ch+=7;
			System.out.println();
		}
	}
}
