import java.util.Scanner;

class Pattern10 
{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no of Rows : ");
		int n = sc.nextInt();
		
		for (int i=n ;i>=1 ;i-- )
		{
			int num =i;
			for (int j=1;j<=n ;j++ )
			{
				System.out.print(num + " ");
				if(num<10) { System.out.print(" "); }
				num+=4;
			}
			System.out.println();
		}
	}
}
