class Perfect 
{
	public static void main(String[] args) 
	{	int num = 8;
		int sum =0;
		for(int i =1; i<=num/2 ; i++ ){
			if (num%i==0 )
			{
				sum = sum + i;
			}
		}
		
		if (num == sum )
		{
			System.out.println("It is Perfect NO ");
		}else{
			System.out.println("It is not Perfect No ");
		}
	}
}
