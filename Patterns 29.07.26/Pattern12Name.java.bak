class Pattern12Name 
{
	public static void main(String[] args) 
	{
		int n = 11;
		
		//p
		for (int i =0 ; i<n ; i++ )
		{
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || i==0 || j==n-1 && i<n/2 || i==n/2)
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				
				System.out.print(" ");//for space after a letter 
			}
			
			//System.out.println();
			
			
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || i==0 || j==n-1 && i<n/2 || i==n/2 || i==j && i>n/2  )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				
				System.out.print(" ");
			}
			
			
			//A
			
			for (int j = 0; j< n ; j++ )
			{
				if ( i+j==n/2  || j==0 && i>n/2 || i==n/2 || j==n-1&& i>n/2 || j-i == n/2   ) //imp important last condition 
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				
				System.out.print(" ");//for space after a letter 
			}
			
			//T
			
			for (int j = 0; j< n ; j++ )
			{
				if ( i==0 || j==n/2  )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				
				System.out.print(" ");//for space after a letter 
			}
			
			//H
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || j==n-1 || i==n/2  )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				
				System.out.print(" ");//for space after a letter 
			}
			
			//A
			for (int j = 0; j< n ; j++ )
			{
				if ( i+j==n/2  || j==0 && i>n/2 || i==n/2 || j==n-1&& i>n/2 || j-i == n/2   ) //imp important last condition 
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				System.out.print(" ");//for space after a letter 
				
			}
			
			//M
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || j==n-1 || i==j && i<n/2 || i+j==n-1 && i<=n/2 )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				System.out.print(" ");//for space after a letter 
				
			}
			//E
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || i==0 || i==n/2  || i==n-1  )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				System.out.print(" ");//for space after a letter 
				
			}
			
			//S
			for (int j = 0; j< n ; j++ )
			{
				if ( i==0  || j==0 && i<n/2 || i==n/2 || j==n-1 && i>n/2 || i==n-1  )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				System.out.print(" ");//for space after a letter 
				
			}
			
			//H
			for (int j = 0; j< n ; j++ )
			{
				if ( j==0 || i==n/2 || j==n-1   )
				{				
					System.out.print("*"+" ");
				}
				else
				{				
					System.out.print(" "+" ");
				}
				System.out.print(" ");//for space after a letter 
				
			}
			
			
			
			System.out.println();
			
			
		}
		
		
		
		
		
		
	}
}
