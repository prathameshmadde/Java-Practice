import java.util.Scanner;

class  Pattern2RectangleBlock
{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no : ");
		
		
		for (int i=0 ; i<5 ; i++ )
		{
			for (int j=0 ; j<3 ; j++)
			{
				System.out.print("*"+" ");
			}
			System.out.println();
		}
	}
}