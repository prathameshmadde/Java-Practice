import java.util.Scanner;

class  Pattern10{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no of rows : ");
		int n = sc.nextInt();
		
		int num=1;
		
		
		for (int i=1 ; i<=n ; i++ )
		{	int a=i;
			for (int j=1 ; j<=n ; j++)
				
			{
				System.out.print(a + " ");
				a+=3;
				
			}
			System.out.println();
		}
	}
}