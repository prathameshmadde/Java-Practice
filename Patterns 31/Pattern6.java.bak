import java.util.Scanner;

class  Pattern6{
	public static void main(String[] args) 
	{	Scanner sc = new Scanner(System.in);
		System.out.println("Enter no of rows : ");
		int n = sc.nextInt();
		char num =(char)('a' + n*n -1);
		
		
		for (int i=1 ; i<=n ; i++ )
		{
			for (int j=1 ; j<=n ; j++)
				
			{
				System.out.print(num++ + " ");
				if(num<9)System.out.print(" ");
			}
			System.out.println();
		}
	}
}